# Roadmaps, cover letters, and rubric analyses do not belong in it.
career/
*cover-letter*
*roadmap*
HANDOFF.md

# Session state
sessions/
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.DS_Store

# generated by evals/run_agent_eval.py --synthetic
.eval_corpus/

